{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/*.spec.ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/index.ts"
  ],
  "coverageDirectory": "coverage",
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/jest.setup.ts"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setupAfterEnv.ts"]
}
